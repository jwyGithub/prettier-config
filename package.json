{
    "name": "@jawyn/prettier-config",
    "type": "module",
    "version": "0.0.1",
    "description": "A prettier config for jawyn",
    "author": "jawyn <jiangweiye@outlook.com> (https://github.com/jwyGithub)",
    "license": "SEE LICENSE IN LICENSE.md",
    "homepage": "https://github.com/jwyGithub/prettier-config",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "prettier",
        "config"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./format": {
            "types": "./dist/src/format.d.mts",
            "import": "./dist/src/format.mjs",
            "require": "./dist/src/format.cjs"
        },
        "./options": {
            "types": "./dist/src/options.d.mts",
            "import": "./dist/src/options.mjs",
            "require": "./dist/src/options.cjs"
        },
        "./*": "./*"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typesVersions": {
        ".": {
            "*": [
                "./dist/index.d.mts"
            ],
            "options": [
                "./dist/src/options.d.mts"
            ],
            "format": [
                "./dist/src/format.d.mts"
            ]
        }
    },
    "bin": {
        "prettier-config": "bin/index.js"
    },
    "files": [
        "bin",
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "cli": "esno src/cli/cli.ts",
        "prettier": "pnpx prettier --write .",
        "lint-staged": "lint-staged"
    },
    "dependencies": {
        "@clack/prompts": "^0.7.0",
        "picocolors": "^1.0.1",
        "prettier": "^3.3.3",
        "yargs": "^17.7.2"
    },
    "optionalDependencies": {
        "prettier": "^3.6.2"
    },
    "devDependencies": {
        "@jawyn/prettier-config": "workspace:*",
        "@jawyn/tsconfig": "^0.0.1",
        "@types/node": "^22.5.0",
        "@types/yargs": "^17.0.33",
        "esno": "^4.8.0",
        "lint-staged": "^15.2.10",
        "tsdown": "^0.21.8",
        "typescript": "^5.5.4"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "pnpm prettier"
        ]
    }
}
